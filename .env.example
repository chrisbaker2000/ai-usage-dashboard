# Optional environment overrides. None are required and none are secrets.
# Install and the full config file are in README.md.
# Settings normally live in ~/Library/Application Support/ai-usage-dashboard/config.toml.
#
# These are file settings only. They have no USAGEDASH_* variable:
# backfill_days, warn_percent, critical_percent, expected_accounts_per_provider.
# An environment value overrides the file for every variable below.

# Directory for the database, config file, and standing login homes.
# USAGEDASH_DATA_DIR=~/Library/Application Support/ai-usage-dashboard

# Path to the TOML config file (defaults to config.toml inside the data directory).
# USAGEDASH_CONFIG=~/Library/Application Support/ai-usage-dashboard/config.toml

# Loopback port for the dashboard (1024-65535).
# USAGEDASH_PORT=8787

# Seconds between collection cycles (minimum 60, maximum 86400).
# USAGEDASH_POLL_INTERVAL_SECONDS=300

# Path of each vendor CLI, ahead of [binaries] in the config file. `usagedash agent install` sets these
# in the agent's environment to the CLIs the installing shell found, so the agent runs exactly those.
# USAGEDASH_CLAUDE_BINARY=~/.local/bin/claude
# USAGEDASH_CODEX_BINARY=/opt/homebrew/bin/codex
# USAGEDASH_GROK_BINARY=~/.grok/bin/grok
